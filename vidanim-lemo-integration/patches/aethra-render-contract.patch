 requestAnimationFrame(tick);
+
+// Agent-facing contract for deterministic frame capture and review.
+// This example draws to its existing 512x288 canvas; CSS scaling does not increase
+// the internal render resolution.
+window.DUR = DUR;
+window.FPS = 30;
+window.READY = true;
+window.PROJECT = {
+  title: "Aethra — a 60 second journey",
+  width: W,
+  height: H,
+  fps: window.FPS,
+  duration: DUR,
+  coordinateSpace: "canvas-pixels",
+  renderWidth: W,
+  renderHeight: H
+};
+window.EV = [
+  { t: 44, type: "visual", id: "aether-spire-rise-start" },
+  { t: 46, type: "visual", id: "aether-spire-glow-start" },
+  { t: 55, type: "visual", id: "closing-title-start" }
+];
+window.TEXTS = function visibleTextsAt(at) {
+  const time = Math.max(0, Math.min(DUR, Number(at) || 0));
+  const texts = [];
+  if (time >= 0.8 && time < 5.5) {
+    texts.push({ id: "opening-title", text: "Aethra", x0: 180, y0: 120, x1: 332, y1: 150 });
+    texts.push({ id: "opening-subtitle", text: "A JOURNEY IN SIXTY SECONDS", x0: 120, y0: 146, x1: 392, y1: 168 });
+  }
+  if (time >= 55) {
+    texts.push({ id: "closing-title", text: "The Aether Spire", x0: 150, y0: 238, x1: 362, y1: 268 });
+  }
+  return texts;
+};
+window.render = function renderAt(at) {
+  const requested = Number(at);
+  const target = Number.isFinite(requested)
+    ? Math.max(0, Math.min(DUR, requested))
+    : 0;
+  playing = false;
+  stopMusic();
+  pp.textContent = target >= DUR ? "Replay" : "Play ♪";
